
import 'package:flutter/material.dart';

void main() {
  runApp(const EcoWattApp());
}

class EcoWattApp extends StatelessWidget {
  const EcoWattApp({super.key});

  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      debugShowCheckedModeBanner: false,
      title: 'EcoWatt',
      theme: ThemeData(
        useMaterial3: true,
        colorScheme: ColorScheme.fromSeed(
          seedColor: const Color(0xFF247747),
        ),
        scaffoldBackgroundColor: const Color(0xFFF2F7F2),
      ),
      home: const DashboardPage(),
    );
  }
}

class DashboardPage extends StatefulWidget {
  const DashboardPage({super.key});

  @override
  State<DashboardPage> createState() => _DashboardPageState();
}

class _DashboardPageState extends State<DashboardPage> {
  int selectedCard = -1;
  int focusCard = -1;

  double panelX = 0;
  double panelY = 0;

  double production = 320;
  double batteryLevel = 85;

  final double consumption = 210;
  bool panelMoved = false;

  final List<Map<String, dynamic>> energyCards = [
    {
      'title': 'Panel Surya',
      'icon': Icons.solar_power,
      'color': const Color(0xFFFFB74D),
      'detail': 'Daya produksi panel surya berubah ketika panel digeser.',
    },
    {
      'title': 'Baterai',
      'icon': Icons.battery_charging_full,
      'color': const Color(0xFF43A66B),
      'detail': 'Persentase baterai berubah mengikuti simulasi produksi energi.',
    },
    {
      'title': 'Konsumsi',
      'icon': Icons.bolt,
      'color': const Color(0xFF42A5F5),
      'detail': 'Konsumsi listrik merupakan nilai simulasi yang stabil.',
    },
    {
      'title': 'Penghematan',
      'icon': Icons.eco,
      'color': const Color(0xFF9575CD),
      'detail': 'Indikator surplus menunjukkan produksi dibanding konsumsi.',
    },
  ];

  // Persentase surplus produksi terhadap konsumsi.
  double get savings {
    return (((production - consumption) / consumption) * 100)
        .clamp(0.0, 100.0)
        .toDouble();
  }

  String get energyStatus {
    if (production >= consumption + 100) {
      return 'Surplus Energi';
    } else if (production > consumption) {
      return 'Energi Stabil';
    } else {
      return 'Produksi Rendah';
    }
  }

  Color get statusColor {
    if (production >= consumption + 100) {
      return const Color(0xFF43A66B);
    } else if (production > consumption) {
      return const Color(0xFFFFB74D);
    } else {
      return const Color(0xFFE57373);
    }
  }

  void showCardDetail(int index) {
    setState(() {
      selectedCard = index;
    });

    showDialog(
      context: context,
      builder: (dialogContext) => AlertDialog(
        title: Text(energyCards[index]['title'] as String),
        content: Text(energyCards[index]['detail'] as String),
        actions: [
          TextButton(
            onPressed: () => Navigator.pop(dialogContext),
            child: const Text('Mengerti'),
          ),
        ],
      ),
    );
  }

  // GESTURE 3: DRAG / PAN
  void movePanel(
    DragUpdateDetails details,
    double maxX,
    double maxY,
  ) {
    setState(() {
      panelX = (panelX + details.delta.dx)
          .clamp(0.0, maxX)
          .toDouble();

      panelY = (panelY + details.delta.dy)
          .clamp(0.0, maxY)
          .toDouble();

      panelMoved = true;

      // Simulasi produksi berubah berdasarkan posisi panel.
      final oldProduction = production;

      production = (320 + panelX * 0.5 - panelY * 0.3)
          .clamp(100.0, 500.0)
          .toDouble();

      // Baterai ikut berubah berdasarkan perubahan produksi.
      final productionDifference = production - oldProduction;

      batteryLevel = (batteryLevel + productionDifference * 0.025)
          .clamp(5.0, 100.0)
          .toDouble();
    });
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: const Text(
          'EcoWatt',
          style: TextStyle(fontWeight: FontWeight.bold),
        ),
        backgroundColor: const Color(0xFFF2F7F2),
        actions: const [
          Padding(
            padding: EdgeInsets.only(right: 16),
            child: Icon(
              Icons.eco,
              color: Color(0xFF247747),
            ),
          ),
        ],
      ),
      body: SafeArea(
        child: SingleChildScrollView(
          padding: const EdgeInsets.all(16),
          child: Column(
            crossAxisAlignment: CrossAxisAlignment.start,
            children: [
              const Text(
                'Energi Bersih, Masa Depan Hijau',
                style: TextStyle(
                  fontSize: 22,
                  fontWeight: FontWeight.bold,
                ),
              ),
              const SizedBox(height: 6),
              const Text(
                'Pantau dan eksplorasi energi terbarukan.',
                style: TextStyle(color: Colors.black54),
              ),
              const SizedBox(height: 20),

              // STACK: produksi energi dan dekorasi matahari.
              Stack(
                children: [
                  Container(
                    width: double.infinity,
                    padding: const EdgeInsets.all(20),
                    decoration: BoxDecoration(
                      color: const Color(0xFF194C35),
                      borderRadius: BorderRadius.circular(20),
                    ),
                    child: Column(
                      crossAxisAlignment: CrossAxisAlignment.start,
                      children: [
                        const Text(
                          'Produksi Energi',
                          style: TextStyle(color: Colors.white70),
                        ),
                        const SizedBox(height: 8),
                        Text(
                          '${production.toStringAsFixed(0)} W',
                          style: const TextStyle(
                            fontSize: 34,
                            fontWeight: FontWeight.bold,
                            color: Colors.white,
                          ),
                        ),
                        const SizedBox(height: 12),

                        // Status ikut berubah saat panel digeser.
                        Container(
                          padding: const EdgeInsets.symmetric(
                            horizontal: 10,
                            vertical: 6,
                          ),
                          decoration: BoxDecoration(
                            color: statusColor,
                            borderRadius: BorderRadius.circular(20),
                          ),
                          child: Text(
                            energyStatus,
                            style: const TextStyle(
                              color: Colors.white,
                              fontWeight: FontWeight.bold,
                              fontSize: 12,
                            ),
                          ),
                        ),
                        const SizedBox(height: 8),
                        const Text(
                          'Data simulasi panel surya',
                          style: TextStyle(color: Colors.white70),
                        ),
                      ],
                    ),
                  ),
                  const Positioned(
                    right: 18,
                    top: 18,
                    child: Icon(
                      Icons.wb_sunny,
                      color: Color(0xFFFFD166),
                      size: 36,
                    ),
                  ),
                ],
              ),

              const SizedBox(height: 22),
              const Text(
                'Status Energi',
                style: TextStyle(
                  fontSize: 18,
                  fontWeight: FontWeight.bold,
                ),
              ),
              const SizedBox(height: 10),

              Column(
                children: [
                  Row(
                    crossAxisAlignment: CrossAxisAlignment.start,
                    children: [
                      Expanded(child: buildEnergyCard(0)),
                      const SizedBox(width: 10),
                      Expanded(child: buildEnergyCard(1)),
                    ],
                  ),
                  Row(
                    crossAxisAlignment: CrossAxisAlignment.start,
                    children: [
                      Expanded(child: buildEnergyCard(2)),
                      const SizedBox(width: 10),
                      Expanded(child: buildEnergyCard(3)),
                    ],
                  ),
                ],
              ),

              const SizedBox(height: 22),
              const Text(
                'Simulasi Panel Surya',
                style: TextStyle(
                  fontSize: 18,
                  fontWeight: FontWeight.bold,
                ),
              ),
              const SizedBox(height: 8),
              const Text(
                'Tekan dan geser panel untuk mengubah produksi energi.',
                style: TextStyle(color: Colors.black54),
              ),
              const SizedBox(height: 10),

              // STACK: panel dapat digeser menggunakan GestureDetector.
              LayoutBuilder(
                builder: (context, constraints) {
                  const panelSize = 90.0;
                  final maxX = (constraints.maxWidth - panelSize)
                      .clamp(0.0, double.infinity)
                      .toDouble();

                  const areaHeight = 220.0;
                  const maxY = areaHeight - panelSize;

                  final safeX = panelX.clamp(0.0, maxX).toDouble();
                  final safeY = panelY.clamp(0.0, maxY).toDouble();

                  return Container(
                    height: areaHeight,
                    width: double.infinity,
                    clipBehavior: Clip.hardEdge,
                    decoration: BoxDecoration(
                      color: const Color(0xFFDCEFE0),
                      borderRadius: BorderRadius.circular(18),
                      border: Border.all(
                        color: const Color(0xFFB5D8BD),
                      ),
                    ),
                    child: Stack(
                      children: [
                        const Positioned(
                          top: 12,
                          right: 14,
                          child: Icon(
                            Icons.wb_sunny,
                            color: Color(0xFFF9B934),
                            size: 35,
                          ),
                        ),
                        Positioned(
                          left: safeX,
                          top: safeY,
                          child: GestureDetector(
                            onPanUpdate: (details) {
                              movePanel(details, maxX, maxY);
                            },
                            child: Container(
                              width: panelSize,
                              height: panelSize,
                              decoration: BoxDecoration(
                                color: panelMoved
                                    ? const Color(0xFF176B3A)
                                    : const Color(0xFF388E5B),
                                borderRadius: BorderRadius.circular(14),
                                border: Border.all(
                                  color: focusCard == 0
                                      ? Colors.orange
                                      : Colors.white,
                                  width: focusCard == 0 ? 4 : 2,
                                ),
                              ),
                              child: const Column(
                                mainAxisAlignment: MainAxisAlignment.center,
                                children: [
                                  Icon(
                                    Icons.solar_power,
                                    color: Colors.white,
                                    size: 35,
                                  ),
                                  Text(
                                    'PANEL',
                                    style: TextStyle(
                                      color: Colors.white,
                                      fontWeight: FontWeight.bold,
                                    ),
                                  ),
                                ],
                              ),
                            ),
                          ),
                        ),
                        Positioned(
                          bottom: 8,
                          left: 8,
                          child: Text(
                            'X: ${safeX.toStringAsFixed(0)}'
                            '  Y: ${safeY.toStringAsFixed(0)}',
                            style: const TextStyle(
                              fontSize: 12,
                              color: Color(0xFF194C35),
                            ),
                          ),
                        ),
                      ],
                    ),
                  );
                },
              ),

              const SizedBox(height: 12),
              Card(
                child: Padding(
                  padding: const EdgeInsets.all(14),
                  child: Row(
                    children: [
                      const Icon(
                        Icons.info_outline,
                        color: Color(0xFF247747),
                      ),
                      const SizedBox(width: 10),
                      Expanded(
                        child: Text(
                          'Status saat ini: $energyStatus. '
                          'Produksi ${production.toStringAsFixed(0)} W, '
                          'konsumsi ${consumption.toStringAsFixed(0)} W.',
                          style: const TextStyle(fontSize: 12),
                        ),
                      ),
                    ],
                  ),
                ),
              ),

              const SizedBox(height: 16),
              Card(
                child: Padding(
                  padding: const EdgeInsets.all(14),
                  child: Row(
                    children: [
                      const Icon(
                        Icons.public,
                        color: Color(0xFF247747),
                        size: 32,
                      ),
                      const SizedBox(width: 12),
                      const Expanded(
                        child: Column(
                          crossAxisAlignment: CrossAxisAlignment.start,
                          children: [
                            Text(
                              'SDG 7: Energi Bersih',
                              style: TextStyle(
                                fontWeight: FontWeight.bold,
                              ),
                            ),
                            Text(
                              'Mendukung energi yang bersih dan terjangkau.',
                              style: TextStyle(fontSize: 12),
                            ),
                          ],
                        ),
                      ),
                    ],
                  ),
                ),
              ),
            ],
          ),
        ),
      ),
    );
  }

  Widget buildEnergyCard(int index) {
    final item = energyCards[index];
    final isSelected = selectedCard == index;
    final isFocused = focusCard == index;

    // Nilai kartu dibaca dari state terbaru.
    final String displayValue;

    switch (index) {
      case 0:
        displayValue = '${production.toStringAsFixed(0)} W';
        break;
      case 1:
        displayValue = '${batteryLevel.toStringAsFixed(0)}%';
        break;
      case 2:
        displayValue = '${consumption.toStringAsFixed(0)} W';
        break;
      case 3:
        displayValue = '${savings.toStringAsFixed(0)}%';
        break;
      default:
        displayValue = '-';
    }

    return GestureDetector(
      // GESTURE 1: TAP
      onTap: () => showCardDetail(index),

      // GESTURE 2: LONG PRESS
      onLongPress: () {
        setState(() {
          focusCard = focusCard == index ? -1 : index;
        });

        ScaffoldMessenger.of(context).showSnackBar(
          SnackBar(
            content: Text(
              focusCard == index
                  ? 'Mode fokus ${item['title']} aktif'
                  : 'Mode fokus dinonaktifkan',
            ),
            duration: const Duration(seconds: 1),
          ),
        );
      },

      child: AnimatedScale(
        scale: isFocused ? 1.04 : 1.0,
        duration: const Duration(milliseconds: 180),
        child: Card(
          elevation: isFocused ? 7 : 2,
          color: isFocused
              ? (item['color'] as Color).withValues(alpha: 0.20)
              : isSelected
                  ? const Color(0xFFDCEFE0)
                  : Colors.white,
          shape: RoundedRectangleBorder(
            borderRadius: BorderRadius.circular(16),
            side: BorderSide(
              color: isFocused
                  ? item['color'] as Color
                  : Colors.transparent,
              width: 2,
            ),
          ),
          child: Padding(
            padding: const EdgeInsets.all(14),
            child: Column(
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                Icon(
                  item['icon'] as IconData,
                  color: item['color'] as Color,
                  size: 30,
                ),
                const SizedBox(height: 10),
                Text(
                  item['title'] as String,
                  style: const TextStyle(fontSize: 13),
                ),
                const SizedBox(height: 4),
                Text(
                  displayValue,
                  style: const TextStyle(
                    fontSize: 20,
                    fontWeight: FontWeight.bold,
                  ),
                ),
                if (index == 1) ...[
                  const SizedBox(height: 6),
                  LinearProgressIndicator(
                    value: batteryLevel / 100,
                    color: const Color(0xFF43A66B),
                    backgroundColor: Colors.black12,
                    borderRadius: BorderRadius.circular(8),
                  ),
                ],
                if (index == 0 && panelMoved)
                  const Text(
                    'DIPERBARUI',
                    style: TextStyle(
                      fontSize: 10,
                      fontWeight: FontWeight.bold,
                      color: Color(0xFF247747),
                    ),
                  ),
                if (isFocused)
                  const Text(
                    'MODE FOKUS',
                    style: TextStyle(
                      fontSize: 10,
                      fontWeight: FontWeight.bold,
                    ),
                  ),
              ],
            ),
          ),
        ),
      ),
    );
  }
}
